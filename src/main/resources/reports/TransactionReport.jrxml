<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TransactionReport" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <!-- Parameters -->
    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="accountId" class="java.lang.String"/>
    <parameter name="accountBalance" class="java.lang.Double"/>
    <parameter name="transactionAmount" class="java.math.BigDecimal"/>
    <parameter name="transactionDate" class="java.util.Date"/>
    <parameter name="transactionType" class="java.lang.String"/>

    <!-- Title Band -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="515" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[$P{ReportTitle}]]></text>
            </staticText>
        </band>
    </title>

    <!-- Detail Band -->
    <detail>
        <band height="150">
            <textField>
                <reportElement x="0" y="0" width="515" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Account ID: " + $P{accountId}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="25" width="515" height="20"/>
                <textFieldExpression><![CDATA["Account Balance: " + $P{accountBalance}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="50" width="515" height="20"/>
                <textFieldExpression><![CDATA["Transaction Amount: " + $P{transactionAmount}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="75" width="515" height="20"/>
                <textFieldExpression><![CDATA["Transaction Date: " + $P{transactionDate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="100" width="515" height="20"/>
                <textFieldExpression><![CDATA["Transaction Type: " + $P{transactionType}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
