<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TransactionReceipt" pageWidth="300" pageHeight="400"
              columnWidth="280" leftMargin="10" rightMargin="10"
              topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="accountId" class="java.lang.String"/>
    <parameter name="transactionAmount" class="java.math.BigDecimal"/>
    <parameter name="transactionDate" class="java.util.Date"/>
    <parameter name="transactionType" class="java.lang.String"/>
    <parameter name="accountBalance" class="java.lang.Double"/>

    <!-- Title -->
    <title>
        <band height="70">
            <!-- Main Header -->
            <staticText>
                <reportElement x="0" y="20" width="280" height="40" forecolor="#FFFFFF" backcolor="#007BFF" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Transaction Receipt]]></text>
            </staticText>
        </band>
    </title>

    <!-- Detail Band -->
    <detail>
        <band height="180">
            <!-- Border Box -->
            <rectangle radius="5">
                <reportElement x="5" y="0" width="270" height="180" backcolor="#F8F9FA" mode="Opaque"/>
            </rectangle>

            <!-- Date at top-left inside border -->
            <textField>
                <reportElement x="160" y="10" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy HH:mm").format($P{transactionDate})]]></textFieldExpression>
            </textField>

            <!-- Account ID -->
            <textField>
                <reportElement x="10" y="40" width="260" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Account: " + $P{accountId}]]></textFieldExpression>
            </textField>

            <!-- Amount with CR Indicator -->
            <textField>
                <reportElement x="10" y="60" width="180" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Amount: " + new java.text.DecimalFormat("#,##0.00").format($P{transactionAmount})]]></textFieldExpression>
            </textField>

            <!-- CR Badge -->
            <textField evaluationTime="Now">
                <reportElement x="180" y="60" width="40" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{transactionType}.equals("CR") ? "(CR)" : "(DR)"]]></textFieldExpression>
            </textField>


            <!-- Remaining Balance -->
            <textField>
                <reportElement x="10" y="95" width="260" height="25" forecolor="#2C3E50"/>
                <textElement verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Remaining Balance: $" + new java.text.DecimalFormat("#,##0.00").format($P{accountBalance})]]></textFieldExpression>
            </textField>

            <!-- Separator Line -->
            <line>
                <reportElement x="10" y="150" width="260" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </graphicElement>
            </line>

            <!-- Footer Message -->
            <staticText>
                <reportElement x="10" y="155" width="260" height="20" forecolor="#555555"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[Thank you for banking with us!]]></text>
            </staticText>
        </band>
    </detail>
</jasperReport>